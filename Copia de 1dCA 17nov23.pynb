975c95750","width":""}},"ed9756bcd41e40bcbb2becb975c95750":{"model_module":"@jupyter-widgets/base","model_name":"LayoutModel","model_module_version":"1.2.0","state":{"_model_module":"@jupyter-widgets/base","_model_module_version":"1.2.0","_model_name":"LayoutModel","_view_count":null,"_view_module":"@jupyter-widgets/base","_view_module_version":"1.2.0","_view_name":"LayoutView","align_content":null,"align_items":null,"align_self":null,"border":null,"bottom":null,"display":null,"flex":null,"flex_flow":null,"grid_area":null,"grid_auto_columns":null,"grid_auto_flow":null,"grid_auto_rows":null,"grid_column":null,"grid_gap":null,"grid_row":null,"grid_template_areas":null,"grid_template_columns":null,"grid_template_rows":null,"height":null,"justify_content":null,"justify_items":null,"left":null,"margin":null,"max_height":null,"max_width":null,"min_height":null,"min_width":null,"object_fit":null,"object_position":null,"order":null,"overflow":null,"overflow_x":null,"overflow_y":null,"padding":null,"right":null,"top":null,"visibility":null,"width":null}}}}},"cells":[{"cell_type":"code","metadata":{"id":"N4kk-yJRkNcj","executionInfo":{"status":"ok","timestamp":1700867599320,"user_tz":360,"elapsed":1222,"user":{"displayName":"3l Political Dog","userId":"01498963603867700209"}}},"source":["#secondOrder1dCA.pynb\n","#Author: Jorge Luis Rosas Trigueros\n","#Visualizes the evolution of a 1d CA with 1st and 2nd order rules\n","#Last modification: 17nov23 20:23\n","# https://tinyurl.com/3kt2xpfj\n","\n","import cv2\n","import numpy as np\n","from IPython import display as display\n","import ipywidgets as ipw\n","import PIL\n","from io import BytesIO\n","from random import random"],"execution_count":2,"outputs":[]},{"cell_type":"code","metadata":{"id":"R-eu2pwFiR44","colab":{"base_uri":"https://localhost:8080/","height":526,"referenced_widgets":["e60cd0e0b73c4b86ba5d089ce8535440","4e315275ad134214a9b63bc65c8d9fb5"]},"executionInfo":{"status":"ok","timestamp":1700867600885,"user_tz":360,"elapsed":344,"user":{"displayName":"3l Political Dog","userId":"01498963603867700209"}},"outputId":"5164bcd3-58bc-4ea7-965b-1f528bdf3e69"},"source":["N=100\n","\n","#W12\n","cells0=N*[1]\n","cells1=N*[0]\n","cells2=N*[1]\n","\n","for i in range(N):\n","  cells1[i]= 0 if random()>0.5 else 1\n","\n","\n","#Pruebas practicas\n","rule=[0,0,0,0,1,1,0,0] #w12\n","\n","rule=rule[::-1]\n","\n","def apply_rule(left,center,right):\n","  global rule\n","\n","  return rule[right+2*center+4*left]\n","\n","\n","def my_xor(a,b):\n","  if a==b:\n","    return 0\n","  return 1\n","\n","def iteration():\n","  global cells0,cells1,cells2,N\n","\n","  for i in range(1,N-1):\n","    cells0[i]=my_xor(apply_rule(cells1[i-1],cells1[i],cells1[i+1]),cells2[i])\n","  cells2[:]=cells1[:] #for 2nd order\n","  cells1[:]=cells0[:]\n","\n","x0=0\n","y0=0\n","maxX=500\n","maxY=500\n","color=(255,255,255)\n","margin=1\n","stride = (maxX - 2*margin)/N\n","\n","\n","def graph_cells(img,cells):\n","  global x0,y0,maxX,maxY,margin,color,stride,N\n","  r=5\n","  for i in range(N):\n","    if cells[i]:\n","      start=(int(x0+stride*i+margin),int(y0+margin))\n","      end=(int(x0+stride*(i+1)-margin), int(y0+stride-margin))\n","      cv2.rectangle(img,start,end,color,-1)\n","\n","\n","wIm = ipw.Image()\n","display.display(wIm)\n","\n","img = np.zeros((500, 500, 3), dtype=\"uint8\")\n","\n","graph_cells(img,cells1)\n","y0+=stride\n","\n","while y0<=maxY:\n","  iteration()\n","  graph_cells(img,cells0)\n","  y0+=stride\n","\n","pilIm = PIL.Image.fromarray(img, mode=\"RGB\")\n","with BytesIO() as fOut:\n","    pilIm.save(fOut, format=\"png\")\n","    byPng = fOut.getvalue()\n","\n","# set the png bytes as the image value;\n","# this updates the image in the browser.\n","wIm.value=byPng\n"],"execution_count":3,"outputs":[{"output_type":"display_data","data":{"text/plain":["Image(value=b'')"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"e60cd0e0b73c4b86ba5d089ce8535440"}},"metadata":{}}]},{"cell_type":"code","source":["N=100\n","\n","#W14\n","cells0=N*[1]\n","cells1=N*[1]\n","cells2=N*[0]\n","\n","for i in range(N):\n","  cells1[i]= 0 if random()>0.5 else 1\n","\n","#Pruebas practicas\n","rule=[0,0,0,0,1,1,1,0] #w14\n","\n","rule=rule[::-1]\n","\n","def apply_rule(left,center,right):\n","  global rule\n","\n","  return rule[right+2*center+4*left]\n","\n","\n","def my_xor(a,b):\n","  if a==b:\n","    return 0\n","  return 1\n","\n","def iteration():\n","  global cells0,cells1,cells2,N\n","\n","  for i in range(1,N-1):\n","    cells0[i]=my_xor(apply_rule(cells1[i-1],cells1[i],cells1[i+1]),cells2[i])\n","  cells2[:]=cells1[:] #for 2nd order\n","  cells1[:]=cells0[:]\n","\n","x0=0\n","y0=0\n","maxX=500\n","maxY=500\n","color=(255,255,255)\n","margin=1\n","stride = (maxX - 2*margin)/N\n","\n","\n","def graph_cells(img,cells):\n","  global x0,y0,maxX,maxY,margin,color,stride,N\n","  r=5\n","  for i in range(N):\n","    if cells[i]:\n","      start=(int(x0+stride*i+margin),int(y0+margin))\n","      end=(int(x0+stride*(i+1)-margin), int(y0+stride-margin))\n","      cv2.rectangle(img,start,end,color,-1)\n","\n","\n","wIm = ipw.Image()\n","display.display(wIm)\n","\n","img = np.zeros((500, 500, 3), dtype=\"uint8\")\n","\n","graph_cells(img,cells1)\n","y0+=stride\n","\n","while y0<=maxY:\n","  iteration()\n","  graph_cells(img,cells0)\n","  y0+=stride\n","\n","pilIm = PIL.Image.fromarray(img, mode=\"RGB\")\n","with BytesIO() as fOut:\n","    pilIm.save(fOut, format=\"png\")\n","    byPng = fOut.getvalue()\n","\n","# set the png bytes as the image value;\n","# this updates the image in the browser.\n","wIm.value=byPng"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":526,"referenced_widgets":["c0d3c5e9c6004eaebc17582a6519439c","0b93e56fe083417c9406c1a91debb021"]},"id":"pPPaT1lsm6wI","executionInfo":{"status":"ok","timestamp":1700867684266,"user_tz":360,"elapsed":272,"user":{"displayName":"3l Political Dog","userId":"01498963603867700209"}},"outputId":"92260214-b014-4712-f37c-1175ff0dcb60"},"execution_count":4,"outputs":[{"output_type":"display_data","data":{"text/plain":["Image(value=b'')"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"c0d3c5e9c6004eaebc17582a6519439c"}},"metadata":{}}]},{"cell_type":"code","source":["N=100\n","\n","#W61\n","cells0=N*[0]\n","cells1=N*[1]\n","cells2=N*[0]\n","\n","for i in range(N):\n","  cells1[i]= 0 if random()>0.5 else 1\n","\n","#Pruebas practicas\n","rule=[0,0,1,1,1,1,0,1] #w61\n","\n","rule=rule[::-1]\n","\n","def apply_rule(left,center,right):\n","  global rule\n","\n","  return rule[right+2*center+4*left]\n","\n","\n","def my_xor(a,b):\n","  if a==b:\n","    return 0\n","  return 1\n","\n","def iteration():\n","  global cells0,cells1,cells2,N\n","\n","  for i in range(1,N-1):\n","    cells0[i]=my_xor(apply_rule(cells1[i-1],cells1[i],cells1[i+1]),cells2[i])\n","  cells2[:]=cells1[:] #for 2nd order\n","  cells1[:]=cells0[:]\n","\n","x0=0\n","y0=0\n","maxX=500\n","maxY=500\n","color=(255,255,255)\n","margin=1\n","stride = (maxX - 2*margin)/N\n","\n","\n","def graph_cells(img,cells):\n","  global x0,y0,maxX,maxY,margin,color,stride,N\n","  r=5\n","  for i in range(N):\n","    if cells[i]:\n","      start=(int(x0+stride*i+margin),int(y0+margin))\n","      end=(int(x0+stride*(i+1)-margin), int(y0+stride-margin))\n","      cv2.rectangle(img,start,end,color,-1)\n","\n","\n","wIm = ipw.Image()\n","display.display(wIm)\n","\n","img = np.zeros((500, 500, 3), dtype=\"uint8\")\n","\n","graph_cells(img,cells1)\n","y0+=stride\n","\n","while y0<=maxY:\n","  iteration()\n","  graph_cells(img,cells0)\n","  y0+=stride\n","\n","pilIm = PIL.Image.fromarray(img, mode=\"RGB\")\n","with BytesIO() as fOut:\n","    pilIm.save(fOut, format=\"png\")\n","    byPng = fOut.getvalue()\n","\n","# set the png bytes as the image value;\n","# this updates the image in the browser.\n","wIm.value=byPng"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":526,"referenced_widgets":["967524022cd34cacb32352c1c41f0c2b","ed9756bcd41e40bcbb2becb975c95750"]},"id":"yrVydo6Vnjjb","executionInfo":{"status":"ok","timestamp":1700867689027,"user_tz":360,"elapsed":319,"user":{"displayName":"3l Political Dog","userId":"01498963603867700209"}},"outputId":"7ad08d96-3ab7-48ab-85d1-ac5b32e4b5f1"},"execution_count":5,"outputs":[{"output_type":"display_data","data":{"text/plain":["Image(value=b'')"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"967524022cd34cacb32352c1c41f0c2b"}},"metadata":{}}]}]}